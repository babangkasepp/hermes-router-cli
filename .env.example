# Server
HERMES_ROUTER_HOST=127.0.0.1
HERMES_ROUTER_PORT=20128
HERMES_ROUTER_REQUIRE_API_KEY=true
HERMES_ROUTER_API_KEY=change-this-local-router-key

# Hermes upstream
HERMES_BASE_URL=http://127.0.0.1:3080
HERMES_API_KEY=
HERMES_CHAT_PATH=/v1/chat/completions
HERMES_MODELS_PATH=/v1/models
HERMES_TIMEOUT_MS=120000

# Comma-separated fallback base URLs, optional
HERMES_FALLBACK_BASE_URLS=

# Token saver
HERMES_TOKEN_SAVER_ENABLED=true
HERMES_TOKEN_SAVER_MAX_TOOL_CHARS=12000
HERMES_TOKEN_SAVER_MAX_CONTENT_CHARS=30000

# Logs
HERMES_LOG_LEVEL=info
HERMES_LOG_BODIES=false
